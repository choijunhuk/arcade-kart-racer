[node name="RampUp" type="MeshInstance3D" parent="Geometry"]
# Placed well clear of StartGrid (x in [-28,-2]) so karts start on flat
# ground and drive INTO the climb instead of spawning underneath it. The
# box is longer than its visible span and its low end sits below y=0 on
# purpose: that buries the end cap under the pre-existing flat collision
# floor instead of exposing a wall-like vertical face a kart could clip.
position = Vector3(7, 0.625, 22)
rotation_degrees = Vector3(0, 0, 5.3558)
mesh = SubResource("Mesh_ramp")

