[gd_resource type="Resource" script_class="ItemData" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/schemas/item_data.gd" id="1_item"]
[ext_resource type="Script" path="res://data/schemas/ai_item_use_profile.gd" id="2_ai"]
[ext_resource type="Texture2D" path="res://assets/placeholder/items/storm_beacon.svg" id="3_icon"]
[ext_resource type="PackedScene" path="res://items/instances/storm_beacon/storm_beacon.tscn" id="4_scene"]

[sub_resource type="Resource" id="AI_profile"]
script = ExtResource("2_ai")
